example.lean:
def factorial : Nat → Nat
| 0 => 1
| n + 1 => (n + 1) * factorial n

example.v:
Fixpoint factorial (n : nat) : nat :=
  match n with
  | O => 1
  | S p => (S p) * factorial p
  end.

